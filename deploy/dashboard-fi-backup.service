[Unit]
Description=Sauvegarde de la base — Dashboard FI
After=dashboard-fi.service

[Service]
Type=oneshot
User=dashboard
Group=dashboard
WorkingDirectory=/opt/dashboard-fi
EnvironmentFile=-/etc/default/dashboard-fi
Environment=HOME=/opt/dashboard-fi
Environment=XDG_CACHE_HOME=/opt/dashboard-fi/.cache
ExecStart=/opt/dashboard-fi/scripts/backup_db.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dashboard-fi
