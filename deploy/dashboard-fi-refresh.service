[Unit]
Description=Rafraîchissement des cours — Dashboard FI
After=dashboard-fi.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dashboard
Group=dashboard
WorkingDirectory=/opt/dashboard-fi
EnvironmentFile=-/etc/default/dashboard-fi
Environment=HOME=/opt/dashboard-fi
Environment=XDG_CACHE_HOME=/opt/dashboard-fi/.cache
ExecStart=/opt/dashboard-fi/scripts/refresh_quotes.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dashboard-fi
