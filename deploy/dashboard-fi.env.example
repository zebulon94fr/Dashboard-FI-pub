# Configuration du service Dashboard FI — installé dans /etc/default/dashboard-fi
#
# Ce fichier est lu par les unités systemd et par les scripts de scripts/.
# Après modification : sudo systemctl restart dashboard-fi
#
# Format systemd : CLE=valeur, sans export ni substitution shell.

# ── Écoute ──────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8742
DASHBOARD_HOST=0.0.0.0

# Nombre de processus gunicorn. 2 suffisent largement pour un usage personnel.
DASHBOARD_WORKERS=2

# ── Base de données ─────────────────────────────────────────────────────────
DASHBOARD_DB=/opt/dashboard-fi/dashboard.db

# ── HTTPS (optionnel) ───────────────────────────────────────────────────────
# Décommentez les deux lignes après avoir généré un certificat :
#   sudo -u dashboard ./scripts/generate_cert.sh 192.168.1.50
# Si l'une des deux est renseignée mais illisible, le service refuse de démarrer
# plutôt que de basculer silencieusement en HTTP.
#DASHBOARD_SSL_CERT=/opt/dashboard-fi/certs/cert.pem
#DASHBOARD_SSL_KEY=/opt/dashboard-fi/certs/key.pem

# Schéma utilisé par les scripts qui appellent l'API en local (http ou https).
# À passer à https en même temps que les deux lignes ci-dessus.
DASHBOARD_SCHEME=http

# ── Sauvegardes ─────────────────────────────────────────────────────────────
DASHBOARD_BACKUP_RETENTION_DAYS=14
